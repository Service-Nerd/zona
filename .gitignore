.env.local
.env*.local
node_modules/
.next/
out/
tsconfig.tsbuildinfo
.DS_Store
*.pem
*.p8
docs/keys/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# Claude Code transient agent worktrees — never commit
.claude/worktrees/
# Claude Code local session/memory data — never commit
.claude/projects/

# Incident working data — real user plan JSON / exports. This repo is PUBLIC.
# Never commit raw user data here: plan JSON carries age, HR and training
# history, which is health data about an identifiable person. Written-up,
# aggregated findings in the incident analysis are fine; the raw record is not.
docs/incidents/**/user-*.json
docs/incidents/**/*-export.json

# Ad-hoc operational SQL (contains production user ids) — keep out of the repo
scripts/sql/

# Coaching-review round packets are generated build artifacts (CI uploads them).
coaching-review/*/generated-plans.md
# COACH-MEASURE-PROTOCOL-01 — same class as the line above: a regenerable round
# artifact (504 plans, ~530 lines). The COMMITTED round outputs are review.md,
# backlog.md and post-fix-diff.md. Plan-level change detection is
# `npm run verify:parity`, which hashes 5,994 cases — not a diff of these files.
coaching-review/*/foundation-composed-plans.md
.vitest-report.json

# Generated content exports (regenerate with scripts/export-marketing-plans.ts)
zonna-plans-export.*
supabase/.temp/
