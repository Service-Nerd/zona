{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/coaching/**",
              "components/data/**",
              "components/forms/**",
              "components/marketing/**",
              "components/training/**",
              "ui_kits/app/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|value|chevron|toggle|onToggle|onClick|first|key|ref|className|style|children)$/]",
        "message": "<ActionListRow> doesn't accept that prop. Declared props: label, detail, value, chevron, toggle, onToggle, onClick, first."
      },
      {
        "selector": "JSXOpeningElement[name.name='AdjustmentDiff'] > JSXAttribute > JSXIdentifier[name!=/^(?:changes|key|ref|className|style|children)$/]",
        "message": "<AdjustmentDiff> doesn't accept that prop. Declared props: changes."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|working|label|key|ref|className|style|children)$/]",
        "message": "<AIMark> doesn't accept that prop. Declared props: size, color, working, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppStoreBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:url|comingSoonLabel|liveLabel|key|ref|className|style|children)$/]",
        "message": "<AppStoreBadge> doesn't accept that prop. Declared props: url, comingSoonLabel, liveLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: items, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|active|onClick|layout|locked|lockLabel|ariaLabel|key|ref|className|style|children)$/]",
        "message": "<CardSelect> doesn't accept that prop. Declared props: label, sub, active, onClick, layout, locked, lockLabel, ariaLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardSelect'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|tile)$/]",
        "message": "<CardSelect> layout must be one of 'row' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|onClick|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, active, onClick."
