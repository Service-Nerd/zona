{
  "name": "zonna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.vitest-report.json",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:matrix": "tsx scripts/r23-phase7-validation.ts",
    "verify:sweep": "tsx scripts/property-validate-plans.ts",
    "verify:invariants": "tsx scripts/r2-coverage-check.ts",
    "verify:hooks": "eslint --no-eslintrc --config ./.eslintrc.hooks.json --ext .ts,.tsx --quiet app components lib",
    "verify:rules": "NODE_ENV=production tsx scripts/plan-rules-report.ts",
    "verify:coaching": "NODE_ENV=production tsx scripts/coaching-deviation-scan.ts",
    "verify": "npm run typecheck && npm run verify:hooks && npm run test && npm run check:slow && npm run review:cohort && npm run verify:invariants && npm run verify:matrix && npm run verify:sweep && npm run verify:rules && npm run verify:coaching && npm run audit:plans",
    "sync:ios": "npx cap sync ios && node scripts/fix-cap-config.mjs && node scripts/verify-cap-config.mjs",
    "verify:ios-plugins": "node scripts/verify-cap-config.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "verify:parity": "tsx scripts/verify-parity.ts",
    "check:db": "tsx scripts/check-db-drift.ts",
    "purge:users": "tsx scripts/purge-users.ts",
    "cohort:shape": "tsx scripts/cohort-shape.ts",
    "review:coaching": "NODE_ENV=production tsx scripts/review-coaching.ts",
    "review:cohort": "NODE_ENV=production tsx scripts/cohort-review.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "measure:fitness": "tsx scripts/measure-plan-fitness.ts",
    "invariant:liveness": "tsx scripts/invariant-liveness.ts",
    "test:liveness": "tsx scripts/test-liveness.ts",
    "check:slow": "tsx scripts/check-test-duration.ts",
    "audit:plans": "tsx scripts/audit-plan-quality.ts",
    "audit:plan-shape": "tsx scripts/audit-plan-invariants.ts",
    "measure:envelope": "tsx scripts/measure-envelope.ts",
    "export:plans": "tsx scripts/export-marketing-plans.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capawesome/capacitor-apple-sign-in": "^0.1.0",
    "@capgo/capacitor-health": "^8.4.8",
    "@revenuecat/purchases-capacitor": "^13.1.1",
    "@supabase/ssr": "^0.3.0",
    "@supabase/supabase-js": "^2.43.1",
    "@vercel/functions": "^3.4.4",
    "apn": "^2.2.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/apn": "^0.0.31",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
