#!/usr/bin/env bash
# Pre-commit guard. Three independent checks:
#   1. Palette + font (app/ + components/ only)
#   2. setProperty (app/ + components/ only)
#   3. Data source doctrine — direct writes to strava_activities (whole tree)
# globals.css is excluded from #1/#2 — it is the token authority.

set -euo pipefail

FAIL=0

# ── The colour predicates live in ONE place ──────────────────────────────────
#
# 🔴 `scripts/lib/colour-guards.sh` is the single owner of every colour regex, the
# OG exemption and the comment stripper (`GUARD-TREE-SWEEP-01`, 2026-11-08). This
# hook's job is the POPULATION — staged files — and nothing else. The tree-wide
# sweep (`npm run sweep:colours`) sources the same file, so the two can never
# enforce different rules.
#
# Resolved from the HOOK'S OWN directory, never from `$PWD`: `pre-commit.test.sh`
# runs the real hook with cwd set to a scratch git repo, and a relative source
# would silently find nothing there.
. "$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)/scripts/lib/colour-guards.sh"

# The POPULATION: staged TS/JS under app/ and components/. `globals.css` is the token
# authority and is excluded here, at selection, so the colour rules never read it.
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E "$COLOUR_FILE_REGEX" | grep -vE '^globals\.css$' | grep -E '^(app|components)/' | grep -vE "$PALETTE_EXEMPT_REGEX" || true)

# ── Hardcoded hex colours ─────────────────────────────────────────────────────
HEX_HITS=""
for f in $STAGED; do
  [ -f "$f" ] || continue
  if colour_violations hex "$f" | grep -q .; then
    HEX_HITS="$HEX_HITS$f
"
  fi
done
if [ -n "$HEX_HITS" ]; then
  echo ""
  echo "✗  Hardcoded hex colour detected. Use CSS custom properties from globals.css."
  echo "   (A hex inside a COMMENT is prose about a measurement and is allowed.)"
  echo "$HEX_HITS" | while read -r f; do
    [ -n "$f" ] || continue
    colour_violations hex "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── CSS colour KEYWORD as a property value (GUARD-COLOUR-KEYWORD-01) ────────
#
# 🔴 THE HEX AND rgba RULES BOTH MATCH NUMERIC FORMS, so `color: 'white'` walked past
# BOTH — and past the tree sweep. It was found by WRITING A CONTRACT, not by a guard:
# the only instance in 376 files, on the App Store badge.
#
# ⚠️ ADDED HERE AND NOT ONLY TO THE SWEEP, AND THE REASON IS THE OWNER'S OWN INVARIANT:
# `colour-guards.sh` exists so "the sweep can never enforce a looser rule than the
# commit guard". A rule in the sweep alone inverts that — the sweep becomes STRICTER
# than the hook, and a commit can still introduce what the tree then fails on.
KEYWORD_HITS=""
for f in $STAGED; do
  [ -f "$f" ] || continue
  if colour_violations keyword "$f" | grep -q .; then
    KEYWORD_HITS="$KEYWORD_HITS$f
"
  fi
done
if [ -n "$KEYWORD_HITS" ]; then
  echo ""
  echo "✗  CSS colour KEYWORD as a property value. Use a globals.css token."
  echo "   (--card is #FFFFFF: globals.css names it for a mark on dark, beside --on-ground.)"
  echo "$KEYWORD_HITS" | while read -r f; do
    [ -n "$f" ] || continue
    colour_violations keyword "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Hardcoded rgba() PALETTE values (P-13b, GAP-08) ──────────────────────────
#
# WHY THIS EXISTS. The hex rule above has protected this repo for months and has
# a hole the width of a colour channel: writing the same value as rgba() walks
# straight past it. Measured 2026-09-20 — 26 live rgba instances in app/ and
# components/, 17 of them palette colours at alpha, and one of them is
# rgba(91,192,190) = #5BC0BE, the RETIRED SYSTEM-B TEAL that this very hook
# blocks in hex form. It renders in the generating-ceremony shimmer, which every
# runner sees.
#
# ⚠️ DELIBERATELY QUIET, because a guard that fires on ordinary work gets
# switched off and this repo has recorded that twice as equivalent to no guard.
# Pure white and pure black at alpha are SCRIMS and overlays — there is no token
# for a scrim and there should not be one. Only a NON-greyscale triple is a
# palette colour wearing an alpha channel, and that is all this matches.
RGBA_HITS=""
for f in $STAGED; do
  [ -f "$f" ] || continue
  if colour_violations rgba "$f" | grep -q .; then
    RGBA_HITS="$RGBA_HITS$f
"
  fi
done
if [ -n "$RGBA_HITS" ]; then
  echo ""
  echo "✗  Hardcoded rgba() palette colour detected. Use a CSS custom property from globals.css."
  echo "   (Pure white / pure black at alpha are allowed — those are scrims, not palette.)"
  echo "$RGBA_HITS" | while read -r f; do
    [ -n "$f" ] || continue
    colour_violations rgba "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Banned fonts ──────────────────────────────────────────────────────────────
FONT_HITS=$(echo "$STAGED" | xargs grep -lnE "$FONT_RE" 2>/dev/null || true)
if [ -n "$FONT_HITS" ]; then
  echo ""
  echo "✗  Banned font reference detected. Use var(--font-ui) or var(--font-brand) only."
  echo "$FONT_HITS" | while read -r f; do
    colour_violations font "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── setProperty calls (theme switching) ──────────────────────────────────────
SETP_HITS=$(echo "$STAGED" | xargs grep -lnE "$SETP_RE" 2>/dev/null || true)
if [ -n "$SETP_HITS" ]; then
  echo ""
  echo "✗  style.setProperty() detected. Colour switching is not allowed (ADR-008)."
  echo "$SETP_HITS" | while read -r f; do
    colour_violations setp "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Specifically banned values ────────────────────────────────────────────────
BANNED_HITS=$(echo "$STAGED" | xargs grep -lnE "$BANNED_RE" 2>/dev/null || true)
if [ -n "$BANNED_HITS" ]; then
  echo ""
  echo "✗  Banned palette value detected (ember orange / warm beige / System B colours)."
  echo "$BANNED_HITS" | while read -r f; do
    colour_violations banned "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Data Source Doctrine: direct writes to strava_activities (INV-DATA-008) ──
# HealthKit is the SOR (ADR-011 amended 2026-06-24). Writes to strava_activities
# may only happen through the canonical HK ingest gateway. Strava-direct paths
# are legacy and tolerated until retirement — listed below — but no NEW code
# may add a .from('strava_activities').insert/.upsert(...) chain.
#
# Allowed (SOR ingest + patch gateway):
#   - app/api/health/ingest/         — primary HealthKit ingest
#   - lib/coaching/healthkitConsolidate.ts — patch helper (only .update)
# Tolerated legacy (no new violations of doctrine here either):
#   - app/api/webhooks/strava/       — pending retirement, see ADR-011
#   - app/api/strava/link-activity/  — pending retirement, see ADR-011
ALLOWED_WRITER_REGEX='^(app/api/health/ingest/|app/api/webhooks/strava/|app/api/strava/link-activity/|lib/coaching/healthkitConsolidate\.ts$)'

STAGED_ALL_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx?|jsx?)$' | grep -vE "$ALLOWED_WRITER_REGEX" || true)

if [ -n "$STAGED_ALL_TS" ]; then
  for f in $STAGED_ALL_TS; do
    [ -f "$f" ] || continue
    if perl -0777 -ne 'exit 1 unless /\.from\(["'"'"']strava_activities["'"'"']\)[\s\S]{0,400}?\.(insert|upsert)\(/' "$f"; then
      echo ""
      echo "✗  Direct write to strava_activities outside the allowed ingest gateway (INV-DATA-008)."
      echo "   ADR-011 (amended 2026-06-24): HealthKit is the SOR. Only the canonical"
      echo "   HK ingest gateway may insert into strava_activities. Strava data must enter"
      echo "   via lib/coaching/healthkitConsolidate.ts → tryEnrichHealthKitRow, which"
      echo "   patches existing HK rows. Activities with no HK match are discarded."
      echo "   Offending file: $f"
      FAIL=1
    fi
  done
fi

# ── The coach's name is BRAND.coachName, never a literal (BRAND-COACHNAME-HARDCODED-01) ──
#
# CLAUDE.md: "never hardcode a brand name in any component, comment, or prompt". The product
# has been renamed twice already (Zona -> Vetra -> Zonna) and the coach can be renamed the same
# way; `BRAND.coachName` exists so that costs one line.
#
# Measured 2026-11-13, comments stripped with line numbers preserved: 14 occurrences across 8
# runner-facing files. The item recorded 13 across 7 — it counted components and missed
# `app/api/push/send-daily/route.ts`, which is a NOTIFICATION, i.e. runner-facing text.
#
# ⚠️ A NAME IN A COMMENT IS PROSE AND PASSES, the same rule the colour checks carry
# (HOOK-RGBA-COMMENTS-01) — and the sweep that preceded this guard proved why it matters: a
# plain string replace hit a comment occurrence and left the code one untouched.
# ⚠️ `-preview` harnesses 404 in production and are out of the population by selection.
COACH_STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -E '^(app|components)/' | grep -v '\.test\.' | grep -v preview || true)
COACH_HITS=""
for f in $COACH_STAGED; do
  [ -f "$f" ] || continue
  if strip_comments "$f" | grep -nE '\bKit\b' | grep -q .; then
    COACH_HITS="$COACH_HITS$f
"
  fi
done
if [ -n "$COACH_HITS" ]; then
  echo ""
  echo "✗  The coach's name is hardcoded. Use BRAND.coachName from lib/brand.ts."
  echo "   (A name inside a COMMENT is prose and is allowed.)"
  echo "$COACH_HITS" | while read -r f; do
    [ -n "$f" ] || continue
    strip_comments "$f" | grep -nE '\bKit\b' | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Zod v4 record-key footgun: z.record(<enum>, …) is exhaustive ─────────────
# Under Zod v4, z.record(z.enum(...) | DayKeySchema, value) requires EVERY enum
# key present, so a producer that emits only the keys it has (partial weeks,
# sparse day maps) silently fails validation. This broke AI enrichment for ~4
# months (EnrichedPlanSchema). Use z.partialRecord(...) for fixed-keyset records.
ZOD_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)
if [ -n "$ZOD_TS" ]; then
  for f in $ZOD_TS; do
    [ -f "$f" ] || continue
    if perl -0777 -ne 'exit 1 unless /z\.record\(\s*(DayKeySchema|z\.enum\()/' "$f"; then
      echo ""
      echo "✗  z.record(<enum key>, …) detected — this is exhaustive under Zod v4."
      echo "   A partial keyset (e.g. only the days that have sessions) will fail"
      echo "   validation silently. Use z.partialRecord(<enum>, …) instead."
      echo "   See lib/plan/enrichMaintenance.ts for the correct pattern."
      grep -nE 'z\.record\(' "$f" | head -3 | sed "s|^|   $f:|"
      FAIL=1
    fi
  done
fi

# ── Session classification by display label (D-16/D-17) ──────────────────────
# A long run / shakeout is classified by `role` (or type), never by matching
# words in the display label — the AI enricher rewrites labels, silently breaking
# any label-based classifier (this caused two production bugs). The single owner
# is lib/plan/sessionRole.ts (isLongRun / isShakeout / coachingSessionType); it is
# the only file allowed to fall back to a label heuristic. Logic layers only —
# display maps in components legitimately read labels.
CLASS_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' | grep -E '^(lib/plan/|lib/coaching/|app/api/)' | grep -v 'lib/plan/sessionRole\.ts$' || true)
if [ -n "$CLASS_TS" ]; then
  for f in $CLASS_TS; do
    [ -f "$f" ] || continue
    if perl -0777 -ne 'exit 1 unless /\.label[^;{}]{0,40}includes\(\s*["'"'"'](?:long|shakeout)/i' "$f"; then
      echo ""
      echo "✗  Session classification by display label in $f."
      echo "   A long run / shakeout must be classified structurally, not by label"
      echo "   substring — the AI enricher rewrites labels. Use isLongRun / isShakeout"
      echo "   / coachingSessionType from lib/plan/sessionRole.ts (the single owner)."
      grep -nE '\.label.*includes\(' "$f" | head -3 | sed "s|^|   $f:|"
      FAIL=1
    fi
  done
fi

# ── API route auth boundary (security audit findings 1 & 11) ─────────────────
# Every new/changed app/api/**/route.ts must authenticate at the boundary before
# doing work: getUserFromRequest (user routes) OR a shared-secret / webhook-
# signature check (cron + webhook routes). This is the class that let
# /api/strava/refresh leak any user's token unauthenticated (finding 1) and left
# the auth-check debug endpoint exposed (finding 11).
#
# Intentionally-public routes (og images, waitlist signup) are allowlisted by
# path. Any other deliberate exception must be marked IN-FILE with a line
# comment `// @public-route: <reason>` — which both satisfies this check and
# documents the intent for the next reader.
PUBLIC_ROUTE_REGEX='^app/api/(og/|waitlist/)'
AUTH_SIGNAL_REGEX='getUserFromRequest|secretMatches|CRON_SECRET|STRIPE_WEBHOOK_SECRET|constructEvent|verifyStravaState|REVENUECAT_WEBHOOK_SECRET|STRAVA_WEBHOOK_VERIFY_TOKEN|x-service-key|@public-route'

ROUTE_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^app/api/.*/route\.tsx?$' | grep -vE "$PUBLIC_ROUTE_REGEX" || true)
if [ -n "$ROUTE_TS" ]; then
  for f in $ROUTE_TS; do
    [ -f "$f" ] || continue
    if ! grep -qE "$AUTH_SIGNAL_REGEX" "$f"; then
      echo ""
      echo "✗  API route with no auth boundary: $f"
      echo "   Every route must authenticate before doing work — call"
      echo "   getUserFromRequest (user routes) or verify a shared secret /"
      echo "   webhook signature (cron/webhook routes)."
      echo "   See security audit findings 1 & 11 (docs/security-audit-2026-08.md)."
      echo "   Intentionally public? Add a line comment: // @public-route: <why>"
      FAIL=1
    fi
  done
fi

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "  Commit blocked. Fix the issues above before committing."
  echo ""
  exit 1
fi

exit 0
