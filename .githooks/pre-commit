#!/usr/bin/env bash
# Pre-commit guard. Three independent checks:
#   1. Palette + font (app/ + components/ only)
#   2. setProperty (app/ + components/ only)
#   3. Data source doctrine — direct writes to strava_activities (whole tree)
# globals.css is excluded from #1/#2 — it is the token authority.

set -euo pipefail

FAIL=0

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx?|jsx?)$' | grep -vE '^globals\.css$' | grep -E '^(app|components)/' || true)

# ── Hardcoded hex colours ─────────────────────────────────────────────────────
HEX_HITS=$(echo "$STAGED" | xargs grep -lnE '#[0-9A-Fa-f]{3,8}\b' 2>/dev/null || true)
if [ -n "$HEX_HITS" ]; then
  echo ""
  echo "✗  Hardcoded hex colour detected. Use CSS custom properties from globals.css."
  echo "$HEX_HITS" | while read -r f; do
    grep -nE '#[0-9A-Fa-f]{3,8}\b' "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Banned fonts ──────────────────────────────────────────────────────────────
FONT_HITS=$(echo "$STAGED" | xargs grep -lnE 'DM Mono|DM Sans|Space Grotesk|Bebas Neue' 2>/dev/null || true)
if [ -n "$FONT_HITS" ]; then
  echo ""
  echo "✗  Banned font reference detected. Use var(--font-ui) or var(--font-brand) only."
  echo "$FONT_HITS" | while read -r f; do
    grep -nE 'DM Mono|DM Sans|Space Grotesk|Bebas Neue' "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── setProperty calls (theme switching) ──────────────────────────────────────
SETP_HITS=$(echo "$STAGED" | xargs grep -lnE '\.style\.setProperty\(' 2>/dev/null || true)
if [ -n "$SETP_HITS" ]; then
  echo ""
  echo "✗  style.setProperty() detected. Colour switching is not allowed (ADR-008)."
  echo "$SETP_HITS" | while read -r f; do
    grep -nE '\.style\.setProperty\(' "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Specifically banned values ────────────────────────────────────────────────
BANNED_HITS=$(echo "$STAGED" | xargs grep -lnE '#D4501A|#f5f2ee|#F5F2EE|#0B132B|#5BC0BE' 2>/dev/null || true)
if [ -n "$BANNED_HITS" ]; then
  echo ""
  echo "✗  Banned palette value detected (ember orange / warm beige / System B colours)."
  echo "$BANNED_HITS" | while read -r f; do
    grep -nE '#D4501A|#f5f2ee|#F5F2EE|#0B132B|#5BC0BE' "$f" | head -3 | sed "s|^|   $f:|"
  done
  FAIL=1
fi

# ── Data Source Doctrine: direct writes to strava_activities (INV-DATA-008) ──
# HealthKit is the SOR (ADR-011 amended 2026-06-24). Writes to strava_activities
# may only happen through the canonical HK ingest gateway. Strava-direct paths
# are legacy and tolerated until retirement — listed below — but no NEW code
# may add a .from('strava_activities').insert/.upsert(...) chain.
#
# Allowed (SOR ingest + patch gateway):
#   - app/api/health/ingest/         — primary HealthKit ingest
#   - lib/coaching/healthkitConsolidate.ts — patch helper (only .update)
# Tolerated legacy (no new violations of doctrine here either):
#   - app/api/webhooks/strava/       — pending retirement, see ADR-011
#   - app/api/strava/link-activity/  — pending retirement, see ADR-011
ALLOWED_WRITER_REGEX='^(app/api/health/ingest/|app/api/webhooks/strava/|app/api/strava/link-activity/|lib/coaching/healthkitConsolidate\.ts$)'

STAGED_ALL_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx?|jsx?)$' | grep -vE "$ALLOWED_WRITER_REGEX" || true)

if [ -n "$STAGED_ALL_TS" ]; then
  for f in $STAGED_ALL_TS; do
    [ -f "$f" ] || continue
    if perl -0777 -ne 'exit 1 unless /\.from\(["'"'"']strava_activities["'"'"']\)[\s\S]{0,400}?\.(insert|upsert)\(/' "$f"; then
      echo ""
      echo "✗  Direct write to strava_activities outside the allowed ingest gateway (INV-DATA-008)."
      echo "   ADR-011 (amended 2026-06-24): HealthKit is the SOR. Only the canonical"
      echo "   HK ingest gateway may insert into strava_activities. Strava data must enter"
      echo "   via lib/coaching/healthkitConsolidate.ts → tryEnrichHealthKitRow, which"
      echo "   patches existing HK rows. Activities with no HK match are discarded."
      echo "   Offending file: $f"
      FAIL=1
    fi
  done
fi

# ── Zod v4 record-key footgun: z.record(<enum>, …) is exhaustive ─────────────
# Under Zod v4, z.record(z.enum(...) | DayKeySchema, value) requires EVERY enum
# key present, so a producer that emits only the keys it has (partial weeks,
# sparse day maps) silently fails validation. This broke AI enrichment for ~4
# months (EnrichedPlanSchema). Use z.partialRecord(...) for fixed-keyset records.
ZOD_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' || true)
if [ -n "$ZOD_TS" ]; then
  for f in $ZOD_TS; do
    [ -f "$f" ] || continue
    if perl -0777 -ne 'exit 1 unless /z\.record\(\s*(DayKeySchema|z\.enum\()/' "$f"; then
      echo ""
      echo "✗  z.record(<enum key>, …) detected — this is exhaustive under Zod v4."
      echo "   A partial keyset (e.g. only the days that have sessions) will fail"
      echo "   validation silently. Use z.partialRecord(<enum>, …) instead."
      echo "   See lib/plan/enrichMaintenance.ts for the correct pattern."
      grep -nE 'z\.record\(' "$f" | head -3 | sed "s|^|   $f:|"
      FAIL=1
    fi
  done
fi

# ── Session classification by display label (D-16/D-17) ──────────────────────
# A long run / shakeout is classified by `role` (or type), never by matching
# words in the display label — the AI enricher rewrites labels, silently breaking
# any label-based classifier (this caused two production bugs). The single owner
# is lib/plan/sessionRole.ts (isLongRun / isShakeout / coachingSessionType); it is
# the only file allowed to fall back to a label heuristic. Logic layers only —
# display maps in components legitimately read labels.
CLASS_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.tsx?$' | grep -E '^(lib/plan/|lib/coaching/|app/api/)' | grep -v 'lib/plan/sessionRole\.ts$' || true)
if [ -n "$CLASS_TS" ]; then
  for f in $CLASS_TS; do
    [ -f "$f" ] || continue
    if perl -0777 -ne 'exit 1 unless /\.label[^;{}]{0,40}includes\(\s*["'"'"'](?:long|shakeout)/i' "$f"; then
      echo ""
      echo "✗  Session classification by display label in $f."
      echo "   A long run / shakeout must be classified structurally, not by label"
      echo "   substring — the AI enricher rewrites labels. Use isLongRun / isShakeout"
      echo "   / coachingSessionType from lib/plan/sessionRole.ts (the single owner)."
      grep -nE '\.label.*includes\(' "$f" | head -3 | sed "s|^|   $f:|"
      FAIL=1
    fi
  done
fi

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "  Commit blocked. Fix the issues above before committing."
  echo ""
  exit 1
fi

exit 0
